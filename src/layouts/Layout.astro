---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Ayush Mishra | Assistant Professor & AI/ML Researcher",
  description = "Academic and research portfolio of Ayush Mishra. Assistant Professor at Dayananda Sagar College of Engineering (DSCE), Bengaluru. Researcher in Multimodal Fake News Detection, Vision Transformers, and Data Science."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#08090C" id="themeColorMeta" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Ayush Mishra, DSCE, Dayananda Sagar College of Engineering, SVNIT Surat, Multimodal AI, Fake News Detection, Vision Transformer, BERT, DeBERTa, Data Science, Machine Learning, Assistant Professor" />
  <meta name="author" content="Ayush Mishra" />

  <!-- OpenGraph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Ayush Mishra | Assistant Professor & AI Researcher" />
  <meta property="og:description" content="Research scholar specializing in Multimodal Fake News Detection, Transformers, and MLOps. Assistant Professor @ DSCE Bengaluru." />
  <meta property="og:url" content="https://github.com/ayush190511" />
  <meta property="og:image" content="/assets/mypic.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="/assets/mypic.jpg" />

  <!-- Google Fonts: Inter & Outfit & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/styles.css" />

  <!-- Structured Data JSON-LD for Academics -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Ayush Mishra",
    "jobTitle": "Assistant Professor",
    "worksFor": {
      "@type": "EducationalOrganization",
      "name": "Dayananda Sagar College of Engineering",
      "department": "Information Science and Engineering"
    },
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Sardar Vallabhbhai National Institute of Technology (SVNIT), Surat",
        "hasCredential": "M.Tech in Computer Science and Engineering (Data Science)"
      },
      {
        "@type": "CollegeOrUniversity",
        "name": "Deenbandhu Chhoturam University of Science and Technology",
        "hasCredential": "B.Tech in Computer Science and Engineering"
      }
    ],
    "sameAs": [
      "https://github.com/ayush190511",
      "https://www.linkedin.com/in/ayush190511/"
    ],
    "email": "ayushmishra642001@gmail.com",
    "telephone": "+91-9992619779"
  }
  </script>
</head>
<body>
  <slot />
  <script src="/script.js" is:inline></script>
</body>
</html>
