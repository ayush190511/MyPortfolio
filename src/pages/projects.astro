---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects & Systems | Ayush Mishra">
  <h1>Selected Projects &amp; Systems</h1>
  <p>
    A curated collection of production-grade Machine Learning, Deep Learning, and MLOps systems built with performance, modularity, and reproducible research in mind.
  </p>

  <ul class="editorial-list" style="margin-top: 2rem;">
    <!-- Project 1: Flagship Research Publication System -->
    <li class="editorial-item" id="fake-news-framework">
      <h2 class="item-title" style="border: none; margin-top: 0; padding-bottom: 0;">
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">A Unified Multimodal Fake News Detection Framework (BERT + ViT)</a>
        <span class="badge badge-green">90.18% Test Acc</span>
        <span class="badge">0.9485 ROC-AUC</span>
      </h2>
      <div class="item-meta">Deep Learning • Multimodal Transformers • Springer IC2NS2 '26</div>
      <p class="item-desc">
        End-to-end multimodal detection pipeline combining a <strong>BERT–BiGRU</strong> text encoder for narrative and contextual representation learning with a <strong>Vision Transformer (ViT-B/16)</strong> for visual patch understanding. Features efficient feature concatenation fusion delivering 90.18% accuracy on the 30,900-sample Fakeddit benchmark.
      </p>
      <div class="item-links">
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">[GitHub Repository]</a>
        <button class="action-btn-link open-arch-modal-btn">[View Architecture Deep-Dive ↗]</button>
      </div>
      <div class="tag-strip">
        <span class="tech-tag">PyTorch</span>
        <span class="tech-tag">BERT-Base</span>
        <span class="tech-tag">BiGRU</span>
        <span class="tech-tag">ViT-B/16</span>
        <span class="tech-tag">Feature Concatenation</span>
        <span class="tech-tag">Fakeddit</span>
      </div>
    </li>

    <!-- Project 2 -->
    <li class="editorial-item" id="disease-pipeline">
      <h2 class="item-title" style="border: none; margin-top: 0; padding-bottom: 0;">
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">End-to-End MLOps Disease Classification Pipeline</a>
        <span class="badge">96.55% CV Acc</span>
      </h2>
      <div class="item-meta">MLOps • Containerization • CI/CD • AWS</div>
      <p class="item-desc">
        Production-ready automated image classification system for poultry disease diagnostics. Features dataset versioning with <strong>DVC</strong>, experiment logging with <strong>MLflow</strong>, containerization with <strong>Docker</strong>, and automated deployment to AWS EC2 via <strong>GitHub Actions</strong>.
      </p>
      <div class="item-links">
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">[Pipeline Source Code]</a>
      </div>
      <div class="tag-strip">
        <span class="tech-tag">DVC</span>
        <span class="tech-tag">MLflow</span>
        <span class="tech-tag">Docker</span>
        <span class="tech-tag">FastAPI</span>
        <span class="tech-tag">AWS EC2</span>
        <span class="tech-tag">GitHub Actions</span>
      </div>
    </li>

    <!-- Project 3: GPUCalc -->
    <li class="editorial-item" id="gpucalc">
      <h2 class="item-title" style="border: none; margin-top: 0; padding-bottom: 0;">
        <a href="https://gpu-calc.ayushmishra642001.workers.dev/" target="_blank" rel="noopener noreferrer">GPUCalc — Deep Learning &amp; LLM VRAM Sizing Engine</a>
        <span class="badge badge-green">Live Tool</span>
      </h2>
      <div class="item-meta">Deep Learning Infrastructure • Memory Analytics • Cloudflare Workers</div>
      <p class="item-desc">
        High-precision hardware sizing and VRAM calculation engine for deep learning and Large Language Model (LLM) training and inference. Computes model parameter footprint, KV cache allocation, activation memory, optimizer state overhead (AdamW/SGD), and multi-GPU tensor/pipeline parallelism configurations.
      </p>
      <div class="item-links">
        <a href="https://gpu-calc.ayushmishra642001.workers.dev/" target="_blank" rel="noopener noreferrer">[Visit Live Calculator ↗]</a>
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">[GitHub Repository]</a>
      </div>
      <div class="tag-strip">
        <span class="tech-tag">Cloudflare Workers</span>
        <span class="tech-tag">Deep Learning Hardware</span>
        <span class="tech-tag">VRAM Analytics</span>
        <span class="tech-tag">LLM Inference &amp; Training</span>
        <span class="tech-tag">Parallelism (TP/PP/DP)</span>
        <span class="tech-tag">JavaScript ES6+</span>
      </div>
    </li>

    <!-- Project 4 -->
    <li class="editorial-item" id="all-age-calculator">
      <h2 class="item-title" style="border: none; margin-top: 0; padding-bottom: 0;">
        <a href="https://allagecalculators.com" target="_blank" rel="noopener noreferrer">AllAgeCalculators.com</a>
        <span class="badge badge-green">Live Web Platform</span>
      </h2>
      <div class="item-meta">Web Platform • Chronological Analytics • Zero-Latency</div>
      <p class="item-desc">
        High-precision chronological analytics platform delivering microsecond client calculations, interactive visualization widgets, responsive UI glassmorphism, and comprehensive SEO optimization.
      </p>
      <div class="item-links">
        <a href="https://allagecalculators.com" target="_blank" rel="noopener noreferrer">[Visit Live Platform ↗]</a>
        <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">[GitHub Repository]</a>
      </div>
      <div class="tag-strip">
        <span class="tech-tag">JavaScript ES6+</span>
        <span class="tech-tag">Chronological Algorithms</span>
        <span class="tech-tag">SEO Optimization</span>
      </div>
    </li>
  </ul>
</Layout>
