---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact & Inquiries | Ayush Mishra">
  <h1>Get in Touch</h1>
  <p>
    I am always open to discussing new engineering opportunities, research collaborations in Multimodal AI and Computer Vision, academic mentorship, or technical consulting.
  </p>

  <p>
    Feel free to send a message using the inquiry form below or connect directly on <a href="https://www.linkedin.com/in/ayush190511/" target="_blank" rel="noopener noreferrer"><strong>LinkedIn</strong></a> and <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer"><strong>GitHub</strong></a>.
  </p>

  <div class="contact-section-box" style="margin-top: 1.5rem;">
    <h3 style="margin-top: 0; margin-bottom: 0.5rem;">Send a Message</h3>

    <form id="contactForm" class="contact-form" action="https://formsubmit.co/ayushmishra642001@gmail.com" method="POST" novalidate>
      <!-- Hidden Configuration for Direct Delivery -->
      <input type="hidden" name="_subject" id="hiddenSubject" value="New Portfolio Inquiry" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />

      <div class="form-row">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" placeholder="Dr. Jane Doe / Alex Smith" required />
          <span id="nameError" class="input-error-msg">Please enter your name.</span>
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="alex@company.com" required />
          <span id="emailError" class="input-error-msg">Please enter a valid email address (e.g. name@domain.com).</span>
        </div>
      </div>

      <div class="form-group">
        <label for="subject">Inquiry Type</label>
        <select id="subject" name="subject">
          <option value="Research Collaboration">Research Collaboration (Multimodal AI / Vision Transformers)</option>
          <option value="AI / ML Engineering & Systems Roles">AI / ML Engineering &amp; Systems Roles</option>
          <option value="IC2NS2 2026 Paper Discussion">IC2NS2 2026 Paper &amp; Multimodal Architecture Discussion</option>
          <option value="Academic Mentorship & DSCE Advising">Academic Mentorship &amp; Advising (DSCE Bengaluru)</option>
          <option value="General Technical Inquiry">General Computer Science &amp; Technical Inquiry</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" placeholder="Tell me about your team, problem space, or research project..." required></textarea>
        <span id="messageError" class="input-error-msg">Please enter your message.</span>
      </div>

      <button type="submit" class="submit-btn" id="submitBtn">Send Message</button>
      <div class="form-status" id="formStatus"></div>
    </form>
  </div>

  <h2 style="margin-top: 2.5rem;">Direct Channels &amp; Profiles</h2>
  <ul class="skills-list" style="margin-top: 1rem;">
    <li>
      <strong>LinkedIn:</strong>
      <a href="https://www.linkedin.com/in/ayush190511/" target="_blank" rel="noopener noreferrer">linkedin.com/in/ayush190511 ↗</a>
    </li>
    <li>
      <strong>GitHub:</strong>
      <a href="https://github.com/ayush190511" target="_blank" rel="noopener noreferrer">github.com/ayush190511 ↗</a>
    </li>
    <li>
      <strong>Academic Affiliation:</strong>
      Dayananda Sagar College of Engineering (DSCE), Bengaluru, Karnataka, India (Dept. of ISE)
    </li>
  </ul>
</Layout>
