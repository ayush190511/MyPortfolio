---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Education & Appointments | Ayush Mishra">
  <h1>Education &amp; Experience</h1>
  <p>
    Academic qualifications, research milestones, teaching mentorship, and standardized competitive credentials.
  </p>

  <ul class="pedigree-list" style="margin-top: 2rem;">
    <!-- 1. Current Appointment (2026 – Present) -->
    <li class="pedigree-item">
      <span class="pedigree-node"></span>
      <div class="pedigree-year">July 20, 2026 – Present</div>
      <h2 class="pedigree-title" style="border: none; margin-top: 0.1rem; padding-bottom: 0;">
        Academic Researcher &amp; Faculty Mentor
        <span class="badge badge-green" style="margin-left: 0.4rem;">Active Appointment</span>
      </h2>
      <div class="pedigree-org">Dayananda Sagar College of Engineering (DSCE), Bengaluru (Dept. of ISE)</div>
      <p class="item-desc" style="margin-top: 0.4rem;">
        Mentoring undergraduate engineering students in Deep Learning architectures, Vision Transformers, and Data Science systems. Guiding applied research initiatives in cross-modal transformer fusion and reproducible machine learning.
      </p>
    </li>

    <!-- 2. Master's Degree (2024 – 2026) -->
    <li class="pedigree-item">
      <span class="pedigree-node"></span>
      <div class="pedigree-year">August 12, 2024 – July 6, 2026</div>
      <h2 class="pedigree-title" style="border: none; margin-top: 0.1rem; padding-bottom: 0;">
        M.Tech in Computer Science and Engineering (Data Science)
        <span class="badge" style="margin-left: 0.4rem;">CGPA: 8.42 / 10</span>
      </h2>
      <div class="pedigree-org">Sardar Vallabhbhai National Institute of Technology (SVNIT), Surat</div>
      <p class="item-desc" style="margin-top: 0.4rem;">
        Specialized in Multimodal Deep Learning, Vision Transformers, High Performance Computing, and Machine Learning Systems. Master's thesis on novel Cross-Modal Gated Fusion for misinformation detection.
      </p>
    </li>

    <!-- 3. GATE Qualification (2024) -->
    <li class="pedigree-item">
      <span class="pedigree-node"></span>
      <div class="pedigree-year">2024</div>
      <h2 class="pedigree-title" style="border: none; margin-top: 0.1rem; padding-bottom: 0;">
        GATE CS 2024 Qualified
        <span class="badge" style="margin-left: 0.4rem;">Score: 514</span>
      </h2>
      <div class="pedigree-org">Graduate Aptitude Test in Engineering (Computer Science &amp; Information Technology)</div>
    </li>

    <!-- 4. Bachelor's Degree (2020 – 2024) -->
    <li class="pedigree-item">
      <span class="pedigree-node"></span>
      <div class="pedigree-year">July 1, 2020 – June 30, 2024</div>
      <h2 class="pedigree-title" style="border: none; margin-top: 0.1rem; padding-bottom: 0;">
        B.Tech in Computer Science and Engineering
        <span class="badge" style="margin-left: 0.4rem;">CGPA: 7.81 / 10</span>
      </h2>
      <div class="pedigree-org">Deenbandhu Chhoturam University of Science and Technology (DCRUST)</div>
      <p class="item-desc" style="margin-top: 0.4rem;">
        Foundational computer science, algorithm optimization, distributed databases, operating systems, compiler design, and software engineering.
      </p>
    </li>
  </ul>
</Layout>
